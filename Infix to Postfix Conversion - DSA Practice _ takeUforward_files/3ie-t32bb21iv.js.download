n.id,t)},advanceSubFeature:function(e,a){if(_.current||null!=e&&e!==S.current||null!=a&&a!==b.current)return;let n=P.current,t=n.findIndex(e=>e.id===S.current),o=n[t]??s,i=o.subFeatures,r=i.findIndex(e=>e.id===b.current);if(r>=0&&r<i.length-1){let e=i[r+1];if(!e)return;let a=w();V(1),p(e.id),m(a,o.id,e.id);return}let l=t<0?0:(t+1)%n.length,c=n[l]??s,d=c.subFeatures[0]??u;if(c.id===o.id&&d.id===b.current)return;let g=w();h(1),V(0),k(c.id),p(d.id),m(g,c.id,d.id)}}}],125325)},322276,e=>{"use strict";var a=e.i(719941);let n=[{data:[{tab_title:"cpp",tab_content:'#include<bits/stdc++.h>\nusing namespace std;\n\nclass Solution {\npublic:\n    // Function to remove duplicates from the vector\n    int removeDuplicates(vector<int>& nums) {\n       \n        \n        // Initialize pointer for unique elements\n        int i = 0;\n        \n        // Iterate through the vector\n        for (int j = 1; j < nums.size(); j++) {\n            /*If current element is different \n            from the previous unique element*/\n            if (nums[i] != nums[j]) {\n                /* Move to the next position in \n                the vector for the unique element*/\n                i++;\n                /* Update the current position \n                with the unique element*/\n                nums[i] = nums[j];\n            }\n        }\n        \n        \n        // Return the number of unique elements\n        return i+1;\n    }\n};\n\nint main() {\n    vector<int> nums = {1, 1, 2, 2, 2, 3, 3};\n    \n    // Create an instance of the Solution class\n    Solution solution;\n    \n    // Call removeDuplicates to remove duplicates from nums\n    int k = solution.removeDuplicates(nums);\n    \n    cout << "The vector after removing duplicate elements is " << endl;\n    for (int i = 0; i < k; i++) {\n        cout << nums[i] << " ";\n    }\n    cout << endl;\n    \n    return 0;\n}'},{tab_title:"java",tab_content:'import java.util.*;\n\nclass Solution {\n    // Function to remove duplicates from the array\n    public int removeDuplicates(int[] nums) {\n        \n        \n        // Initialize pointer for unique elements\n        int i = 0;\n        \n        // Iterate through the array\n        for (int j = 1; j < nums.length; j++) {\n            /*If current element is different \n            from the previous unique element*/\n            if (nums[i] != nums[j]) {\n                /* Move to the next position in \n                the array for the unique element*/\n                i++;\n                /* Update the current position \n                   with the unique element*/\n                nums[i] = nums[j];\n            }\n        }\n        \n        // Return the number of unique elements\n        return i + 1;\n    }\n}\n\npublic class Main {\n    public static void main(String[] args) {\n        int[] nums = {1, 1, 2, 2, 2, 3, 3};\n        \n        // Create an instance of the Solution class\n        Solution solution = new Solution();\n        \n        // Call removeDuplicates to remove duplicates from nums\n        int k = solution.removeDuplicates(nums);\n        \n        System.out.println("The array after removing duplicate elements is ");\n        for (int i = 0; i < k; i++) {\n            System.out.print(nums[i] + " ");\n        }\n        System.out.println();\n    }\n}'},{tab_title:"python",tab_content:'from typing import List\n\nclass Solution:\n    # Function to remove duplicates from the list\n    def removeDuplicates(self, nums: List[int]) -> int:\n      \n        \n        # Initialize pointer for unique elements\n        i = 0\n        \n        # Iterate through the list\n        for j in range(1, len(nums)):\n            """ If current element is different \n            from the previous unique element"""\n            if nums[i] != nums[j]:\n                \n                """ Move to the next position in \n                the list for the unique element"""\n                i += 1\n                \n                """ Update the current position \n                with the unique element"""\n                nums[i] = nums[j]\n        \n        # Return the number of unique elements\n        return i + 1\n\n# Main function to test the implementation\nif __name__ == "__main__":\n    nums = [1, 1, 2, 2, 2, 3, 3]\n    \n    # Create an instance of the Solution class\n    solution = Solution()\n    \n    # Call removeDuplicates to remove duplicates from nums\n    k = solution.removeDuplicates(nums)\n    \n    print("The list after removing duplicate elements is ")\n    for i in range(k):\n        print(nums[i], end=" ")\n    print()'},{tab_title:"javascript",tab_content:'class Solution {\n    // Function to remove duplicates from the array\n    removeDuplicates(nums) {\n      \n        // Initialize pointer for unique elements\n        let i = 0;\n        \n        // Iterate through the array\n        for (let j = 1; j < nums.length; j++) {\n            /* If current element is different \n            from the previous unique element*/\n            if (nums[i] !== nums[j]) {\n                \n                /* Move to the next position in \n                the array for the unique element*/\n                i++;\n                \n                /* Update the current position \n                with the unique element*/\n                nums[i] = nums[j];\n            }\n        }\n        \n        // Return the number of unique elements\n        return i + 1;\n    }\n}\n\n// Main function to test the implementation\nif (typeof require !== \'undefined\' && require.main === module) {\n    let nums = [1, 1, 2, 2, 2, 3, 3];\n    \n    // Create an instance of the Solution class\n    let solution = new Solution();\n    \n    // Call removeDuplicates to remove duplicates from nums\n    let k = solution.removeDuplicates(nums);\n    \n    console.log("The array after removing duplicate elements is ");\n    for (let i = 0; i < k; i++) {\n        process.stdout.write(nums[i] + " ");\n    }\n    console.log();\n}'},{tab_title:"csharp",tab_content:'using System; \nusing System.Collections.Generic; \n\npublic class Solution {\n    // Function to remove duplicates from the array\n    public int removeDuplicates(List<int> nums) {\n        // Edge case: if array is empty\n        if (nums.Count == 0) {\n            return 0;\n        }\n        \n        // Initialize pointer for unique elements\n        int i = 0;\n        \n        // Iterate through the array\n        for (int j = 1; j < nums.Count; j++) {\n            /* If current element is different \n            from the previous unique element*/\n            if (nums[i] != nums[j]) {\n                \n                /* Move to the next position in \n                the array for the unique element*/\n                i++;\n                \n                /* Update the current position \n                with the unique element*/\n                nums[i] = nums[j];\n            }\n        }\n        \n        // Return the number of unique elements\n        return i + 1;\n    }\n}\n\npublic class Program\n{\n    public static void Main(string[] args)\n    {\n        List<int> nums = new List<int> {1, 1, 2, 2, 2, 3, 3};\n        \n        // Create an instance of the Solution class\n        Solution solution = new Solution();\n        \n        // Call removeDuplicates to remove duplicates from nums\n        int k = solution.removeDuplicates(nums);\n        \n        Console.WriteLine("The array after removing duplicate elements is ");\n        for (int i = 0; i < k; i++) {\n            Console.Write(nums[i] + " ");\n        }\n        Console.WriteLine();\n    }\n}'},{tab_title:"go",tab_content:'package main\n\nimport (\n    "fmt"\n)\n\n// removeDuplicates removes duplicates from the slice in-place\nfunc removeDuplicates(nums []int) int {\n    // Edge case: if slice is empty\n    if len(nums) == 0 {\n        return 0\n    }\n\n    // Initialize pointer for unique elements\n    i := 0\n\n    // Iterate through the slice\n    for j := 1; j < len(nums); j++ {\n        /* If current element is different\n           from the previous unique element */\n        if nums[i] != nums[j] {\n            /* Move to the next position in\n               the slice for the unique element */\n            i++\n            /* Update the current position\n               with the unique element */\n            nums[i] = nums[j]\n        }\n    }\n\n    // Return the number of unique elements\n    return i + 1\n}\n\nfunc main() {\n    nums := []int{1, 1, 2, 2, 2, 3, 3}\n\n    // Call removeDuplicates to remove duplicates from nums\n    k := removeDuplicates(nums)\n\n    fmt.Println("The slice after removing duplicate elements is")\n    for i := 0; i < k; i++ {\n        fmt.Print(nums[i], " ")\n    }\n    fmt.Println()\n}'}],"div-id":"tuf-code-editor-1",code_output:""}],t=[{"div-id":"tuf-code-file-tree-1",language_label:"C++",data:[{type:"folder",name:"controller",children:[{type:"file",name:"AdminController.cpp",path:"controller/AdminController.cpp",content:`#include "AdminController.h"
#include "AdminService.h"

using namespace std;

AdminController::AdminController(shared_ptr<AdminService> adminService)
    : adminService(adminService) {}

void AdminController::createAdmin(const Admin& admin) {
    adminService->createAdmin(admin);
}

Admin AdminController::getAdmin(int id) {
    return adminService->getAdmin(id);
}`,language:"cpp"}]},{type:"folder",name:"domain",children:[]},{type:"folder",name:"main",children:[]},{type:"folder",name:"repository",children:[]},{type:"folder",name:"service",children:[{type:"file",name:"nextNameSome.cpp",path:"service/nextNameSome.cpp",content:`#include "nextNameSome.h"

void nextNameSome() {
    // placeholder implementation
}`,language:"cpp"}]}],symbols:[{name:"AdminService",kind:"class",file_path:"controller/AdminController.cpp",line:7,target_file_path:"service/nextNameSome.cpp",target_line:1}]}],o=[{name:"Brute",editorial:[{section:'<div id="editorial-video"></div><h3><strong>Intuition</strong></h3>\n<p>The naive way is to think of a data structure that does not store duplicate elements, that is HashSet. Keep track of unique elements in hashset, and at last copy all the elements from the HashSet to the original array.</p>\n<h3><strong>Approach&nbsp;</strong></h3>\n<li>Declare a HashSet and traverse the array by putting every element of the array in the HashSet.</li>\n<li>Store size of the set in a variable <code>K</code>. Now put all elements of the set in the array from the starting of the array and finally return <code>K</code>.</li>\n<h3>Solution</h3>\n<div id="tuf-code-editor-1"></div>\n<h3><strong>Complexity Analysis&nbsp;</strong></h3>\n<strong>Time Complexity: </strong> O(N * log N) + O(N), for using hashset and traversing once.<br>\n<strong>Space Complexity: </strong> O(N).',examples:[],code_editor:n,tuf_plus_ad:[],image_slider:[],practice_link:[],video:[{asset_id:"5SK8jC3Tu6j"}],code_file_tree:[]}]},{name:"Optimal",editorial:[{section:'<div id="editorial-video"></div><h3><strong>Intuition</strong></h3>\n<p>Imagine you have a shelf where your books are sorted and repeated titles appear. You want each title only once while keeping order.</p>\n<p>Use two pointers: one marks the last unique element and one scans ahead. When a new value appears, place it at the next unique slot.</p>\n<h3><strong>Approach&nbsp;</strong></h3>\n<li>Initialize <code>i = 0</code> and scan using <code>j = 1</code>.</li>\n<li>Whenever <code>nums[j] != nums[i]</code>, increment <code>i</code> and copy <code>nums[j]</code> to <code>nums[i]</code>.</li>\n<li>After traversal, answer is <code>i + 1</code>.</li>\n<h3><strong>Dry Run</strong></h3>\n<div id="tuf-image-slider-1"></div>\n<h3>Solution</h3>\n<div id="tuf-code-editor-1"></div>\n<h3><strong>Complexity Analysis&nbsp;</strong></h3>\n<strong>Time Complexity: </strong> O(N).<br>\n<strong>Space Complexity: </strong> O(1).',examples:[],code_editor:n,tuf_plus_ad:[],image_slider:[{data:[{alt_text:"Image 1",image_url:"https://static.takeuforward.org/premium/Arrays/Logic Building/Remove duplicates from sorted array/2.svg-Q9Y5jWsI"},{alt_text:"Image 2",image_url:"https://static.takeuforward.org/premium/Arrays/Logic Building/Remove duplicates from sorted array/3.svg-eTxILvAf"},{alt_text:"Image 3",image_url:"https://static.takeuforward.org/premium/Arrays/Logic Building/Remove duplicates from sorted array/4.svg-7JgnURfM"},{alt_text:"Image 4",image_url:"https://static.takeuforward.org/premium/Arrays/Logic Building/Remove duplicates from sorted array/5.svg-vB4I0D5a"}],"div-id":"tuf-image-slider-1"}],practice_link:[],video:[{asset_id:"9hFhZRJrSYd"}],code_file_tree:[]}]}];o.map(e=>({label:e.name,value:(0,a.toSolutionValue)(e.name)})),Object.fromEntries(o.map(e=>[(0,a.toSolutionValue)(e.name),e])),e.s(["SOLUTION_PANEL_CODE_EDITOR",0,n,"SOLUTION_PANEL_CODE_FILE_TREE",0,t,"SOLUTION_PANEL_GENERATE_REVISION_COPY",0,{buttonLabel:"Generate Revision",viewButtonLabel:"View Revision",dialogTitle:"Thinking ....",dialogDescription:"Please wait while TUFY is working on revision image.",mascotAlt:"TUFY thinking",mascotSrc:"/tufy/thinking.svg",mediaAlt:"Revision notes image",mediaDialogAriaLabel:"Revision media",downloadLabel:"Download",importLabel:"Import to Notes",missingSlugMessage:"Open a problem to generate revision notes."},"SOLUTION_PANEL_REVISION_NOTE",0,{imageMarkdown:(e,a="Revision notes")=>`![${a}](${e})`,tags:[{label:"Revision",value:"revision"}]}])},415964,118143,15873,e=>{"use strict";var a=e.i(417169),n=e.i(514528),t=e.i(785236);function o(e){return"object"==typeof e&&null!==e}function i(e,a){var n;if(!o(e)||"text"!==(n=e.type)&&"video"!==n)return null;let t=function(e){if(!o(e))return null;let a="string"==typeof e.name?e.name.t