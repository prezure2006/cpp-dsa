 Sets"}},"apti-practice":{title:"Sharpen aptitude topic by topic",description:"Work through topic-wise practice sets to build speed and accuracy before timed mocks. Aptitude practice unlocks with Plus.",videoUrl:"",preview:{featureId:"aptitude-assessments",subFeatureId:"aptitude-practice-sets",label:"Aptitude Practice Sets"}},"subject-quiz":{title:"Quiz your way to interview readiness",description:"Take subject quizzes on OOPs, DBMS, OS, and more to check concepts fast and find weak spots before the real interview. Quizzes unlock with Plus.",videoUrl:"",preview:{mode:"oops-quiz-sequence",label:"OOPs Mock Quiz"}},"company-pass":{title:"Unlock company-focused interview prep",description:"Get deeper access to company interview questions and targeted practice. Upgrade with a Company Pass or Plus.",videoUrl:"",preview:{featureId:"company-interview-prep",subFeatureId:"company-specific-problems",label:"Company Specific Problems"}},"companies-badge":{title:"Explore companies behind each problem",description:"Open company badges to see which firms ask this question and jump into focused company practice. Available with Plus.",videoUrl:"",preview:{featureId:"company-interview-prep",subFeatureId:"company-tags",label:"Company Tags"}},lists:{title:"Organise problems your way",description:"Create and manage custom lists to structure revision, share sets, and stay consistent. Lists unlock with Plus.",videoUrl:"",preview:{featureId:"personal-workspace",subFeatureId:"customised-lists",label:"Create Customised Lists"}},"practice-timer":{title:"Train against the clock",description:"Use the practice timer to simulate interview pacing and track focus time while you solve. Timer unlocks with Plus.",videoUrl:"",preview:{mode:"plus-brand-sequence",label:"Practice Timer"}},"practice-portal":{title:"Practice with full control",description:"Filter by topic and difficulty, shuffle problems, and customise how your practice list looks. The practice portal unlocks with Plus.",videoUrl:"",preview:{featureId:"practice",subFeatureId:"practice-portal",label:"Practice Portal"}},"problem-progress":{title:"Track every problem you solve",description:"Mark problems complete, reopen when you revise, and keep your streak of consistent practice visible. Progress tracking unlocks with Plus.",videoUrl:"",preview:{featureId:"practice",subFeatureId:"problem-of-the-day",label:"Problem of the Day"}},workspace:{title:"Save and organise your code",description:"Save files to CodeSpace, share links, and keep your solutions organised in folders. Personal workspace unlocks with Plus.",videoUrl:"",preview:{featureId:"personal-workspace",subFeatureId:"workspace",label:"Workspace"}},bug:{title:"Report issues while you learn",description:"Flag problem bugs from Plus layout and help us fix content faster. Bug reporting unlocks with Plus.",videoUrl:"",preview:{mode:"bug-report-sequence",label:"Bug Report"}},"save-notes":{title:"Save notes that stay with you",description:"Capture insights as you solve and keep them synced across sessions. Saving notes is a Plus feature.",videoUrl:"",preview:{featureId:"personal-workspace",subFeatureId:"downloadable-notes",label:"Downloadable Notes"}},"example-3-gamification":{title:"Earn rewards as you learn",description:"Attempt gamified example challenges to earn coins and stay motivated while practicing. Gamification unlocks with Plus.",videoUrl:"",preview:{mode:"plus-brand-sequence",label:"takeUforward Plus"}},"bug-report":{title:"Report issues with Plus",description:"Upgrade to Plus to report bugs and track your reports in Buganizer.",videoUrl:"",preview:{mode:"bug-report-sequence",label:"Bug Report"}},planly:{title:"Create your next study plan with Plus",description:"You’ve reached your free plan limit. Upgrade to Plus to create another personalised study plan built around your goals.",videoUrl:"",preview:{mode:"plus-brand-sequence",label:"takeUforward Plus"}}};e.s(["PLUS_UPGRADE_BUG_REPORT_DEMO",0,{type:"bug",category:"problem-bug",priority:"high"