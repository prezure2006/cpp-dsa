`,codeComplete:`int linearSearch(vector<int>& a, int x) {
    for (int i = 0; i < a.size(); i++) {
        if (a[i] == x) return i;
    }
    return -1;
}
`,folderSvg:n};function r(e,t){return Math.max(1,Math.round(e*(2+[...t].reduce((e,t,a)=>e+t.charCodeAt(0)*(a+3),0)%11/10)))}let l=[{name:"Amazon",count:126},{name:"Microsoft",count:94},{name:"Meta",count:81},{name:"Uber",count:68},{name:"Adobe",count:52},{name:"Salesforce",count:49},{name:"Oracle",count:46},{name:"Nvidia",count:44},{name:"Intuit",count:41},{name:"PayPal",count:38},{name:"LinkedIn",count:36},{name:"Google",count:57},{name:"Apple",count:48},{name:"Netflix",count:42},{name:"Goldman Sachs",count:39},{name:"Walmart",count:31},{name:"Atlassian",count:27},{name:"JPMorgan",count:26},{name:"Morgan Stanley",count:24},{name:"Cisco",count:23},{name:"Samsung",count:21},{name:"Airbnb",count:19}].map(({name:e,count:t})=>({name:e,count:r(t,e)})),d=[{name:"Flipkart",count:92},{name:"Swiggy",count:74},{name:"PhonePe",count:81},{name:"Razorpay",count:68},{name:"Paytm",count:55},{name:"Infosys",count:104},{name:"TCS",count:118},{name:"Wipro",count:86},{name:"Zomato",count:67},{name:"HCL",count:64},{name:"Cognizant",count:71},{name:"Accenture",count:96},{name:"Capgemini",count:58},{name:"Freshworks",count:49},{name:"CRED",count:42},{name:"Meesho",count:38},{name:"Groww",count:45},{name:"Zepto",count:36},{name:"Zoho",count:53},{name:"Ola",count:41},{name:"Byju's",count:34},{name:"ShareChat",count:29},{name:"Dream11",count:47},{name:"Nykaa",count:33}].map(({name:e,count:t})=>({name:e,count:r(t,e)})),c={titles:{generate:"Generate Notes",refine:"Refine Notes",save:"Save Notes"},taglineLead:"Generate, refine, organise, and download revision notes with ",taglineAccent:"AI assistance.",generate:{title:"Valid Parentheses",tags:[{label:"stack",value:"stack"},{label:"strings",value:"strings"}],notes:{heading:"Valid Parentheses",lead:"Return true when every opening bracket in the string has a matching closer in the correct order.",sections:[{heading:"Approach",items:["Scan left to right and push opening brackets onto a stack.","On a closer, pop and check it matches — O(n) time, O(n) space."]},{heading:"Edge cases",items:["Empty string","Odd length","Nested and sequential pairs"]}]}},refine:{title:"Two Sum",tags:[{label:"arrays",value:"arrays"},{label:"hashing",value:"hashing"}],draftParagraphs:["two sum - find 2 numbers that add upto the target i think??","i did nested loop first its like O(n^2) kinda slow but it works for small arrays","then hashmap: store nums and look for target-nums[i] if its there we done","wait order of the pair dosent matter i guess. also didnt write the code properly","edge case empty arr?? duplicates?? negatives should be fine i think"],notes:{heading:"Two Sum",lead:"Find two numbers that add up to the target and return their indices.",sections:[{heading:"Approach",items:["Brute force: check every pair with nested loops — O(n²) time.","Hash map: store each value’s index and look up target − nums[i] — O(n) time, O(n) space."]},{heading:"Edge cases",items:["Empty input","Duplicate values","Negative numbers"]}]}}},u={chapters:{overview:{taglineLead:"Introducing TUFY, ",taglineAccent:"your friendly coding companion",taglineTail:" for better learning.",description:"A box full of tools to help you get unstuck, save important notes, and improve your coding approach with personalised reviews"},"ai-doubt-support":{taglineLead:"Help that knows ",taglineAccent:"where you are",description:"Get contextual help whenever you are stuck while learning or coding."},hints:{taglineLead:"Progressive guidance — not the ",taglineAccent:"full answer",description:"Receive progressive guidance without having the complete answer revealed immediately."},"code-review":{taglineLead:"Logic, complexity & ",taglineAccent:"interview follow-ups",description:"Get detailed feedback on your logic, complexity, code quality, edge cases & interview follow-up questions."}},hints:{passedCases:2,totalCases:3,failingAtNumber:3,timeUsed:"12",memoryUsed:"8.4 MB",headerMessage:"Some hidden test cases did not pass. Review edge cases and try again.",lockedTitle:"Not quite there yet",lockedBody:"Some hidden cases are still failing. Revisit your assumptions, test the tricky edges, and give it another shot.",chat:{userText:"My submission got Wrong Answer. Give me a hint about what I might be missing.",assistantIntro:"You cleared most cases — the miss is usually one edge case, not the whole approach.",whatYouDidWell:"The voting loop shape is right, and you already pass the common sample paths.",whatsMissing:"Look at cases where the majority sits at the edges or where the count resets more than once.",hints:[{title:"Hint 1",body:"Trace case #3 by hand: when does `count` hit zero, and which value becomes the new candidate?"},{title:"Hint 2",body:"Ask whether your final candidate is always the majority — or only when it appears more than ⌊n/2⌋ times."}]}},codePanel:{language:"C++",activeTab:0,tabs:["Tab-1"],stuckCtaLabel:"Stuck here?",codePartial:`int majorityElement(vector<int>& nums) {
    int count = 0;
    int candidate = 0;
    for (int x : nums) {
`,editAttempts:["        count += 1;\n"],codeComplete:`int majorityElement(vector<int>& nums) {
    int count = 0;
    int candidate = 0;
    for (int x : nums) {
        if (count == 0) candidate = x;
        count += (x == candidate) ? 1 : -1;
    }
    return candidate;
}
`,lines:[{tokens:[{text:"int",kind:"keyword"},{text:" majorityElement(vector<int>& nums) {",kind:"plain"}]},{tokens:[{text:"    int",kind:"keyword"},{text:" count = 0;",kind:"plain"}]},{tokens:[{text:"    int",kind:"keyword"},{text:" candidate = 0;",kind:"plain"}]},{tokens:[{text:"    for",kind:"keyword"},{text:" (int x : nums) {",kind:"plain"}]},{tokens:[{text:"        if",kind:"keyword"},{text:" (count == 0) candidate = x;",kind:"plain"}]},{tokens:[{text:"        count += (x == candidate) ? 1 : -1;",kind:"plain"}]},{tokens:[{text:"    }",kind:"plain"}]},{tokens:[{text:"    return",kind:"keyword"},{text:" candidate;",kind:"plain"}]},{tokens:[{text:"}",kind:"plain"}]}],testCase:{title:"Test Case",sampleTab:"Sample",hiddenTab:"Hidden",caseLabel:"Case 1",inputLabel:"Input:",fieldLabel:"Nums",inputValue:"[2, 2, 1, 1, 1, 2, 2]"}},codeReview:{accepted:{heading:"Great work!",subheading:"You've successfully solved this problem"},review:{reviewId:1,problemId:1,submissionId:"lf2-preview",language:"cpp",algorithmDetected:"Sort value-index pairs and use the two-pointer technique",timeComplexity:"O(n log n)",spaceComplexity:"O(n)",compactReview:{verdict:"Good and correct solution that preserves original indices while using sorting and two pointers. For interview readiness, mention that a hash map can improve the expected time complexity to O(n), although this implementation is efficient and fully valid.",topSuggestions:["Prefer vector<pair<int, int>> instead of vector<vector> for clearer and more efficient value-index storage.","Mention the O(n log n) sorting cost explicitly and compare it with the expected O(n) hash-map approach.","Use long long for the sum in a general-purpose implementation to avoid integer overflow outside the given constraints."]},detailedReview:{correctness:"The code stores each number together with its original index, sorts these pairs by value, and applies the standard two-pointer method. If the current sum is too small, moving left increases the sum; if it is too large, moving right decreases the sum. Because the original indices are retained, the returned result is valid for the original array. The solution correctly handles duplicate values and never uses the same element twice because left remains strictly less than right.",betterApproach:"A hash map can solve the problem in expected O(n) time with O(n) extra space by checking whether target - nums[i] has already been seen. This is asymptotically faster than the current O(n log n) sorting-based approach.",timeAnalysis:"Building eleIndex takes O(n), sorting takes O(n log n), and the two-pointer scan takes O(n). Therefore, the total time complexity is O(n log n), dominated by sorting.",spaceAnalysis:"The eleIndex structure stores n value-index pairs, requiring O(n) auxiliary space. The sorting algorithm may also use additional implementation-dependent stack or temporary space, but the dominant extra space remains O(n).",readability:"The comments make the logic easy to follow, but vector<vector> and expressions such as eleIndex[left][0] are less clear than a named pair or struct. The ans vector and n variable are acceptable, though returning the pair directly would simplify the successful case.",edgeCases:["Duplicate values such as [3, 3] with target 6 are handled because the two occurrences have different stored indices.","Negative numbers and mixed positive and negative values are handled correctly by sorting and pointer movement.","A solution using the first and last positions is handled because the loop allows left == 0 and right == n - 1.","The minimum input size of two elements is handled correctly.","If no pair exists, the function returns {-1, -1}; under the stated problem guarantee, this fallback is not reached."],interviewExplanation:"I first create value-index pairs so sorting will not lose the original positions. After sorting by value, I place one pointer at the smallest value and one at the largest value. If their sum is smaller than the target, I move the left pointer forward to increase the sum; if it is larger, I move the right pointer backward to decrease it. When the sum matches, I return the two stored original indices. Sorting costs O(n log n), and the pointer scan is linear, so the overall complexity is O(n log n) with O(n) extra space. If the interviewer prioritizes linear expected time, I would use a hash map instead.",followupQuestions:["How would you solve Two Sum in expected O(n) time using an unordered_map?","Why is it necessary to store the original indices before sorting?","How does the two-pointer method remain correct when duplicate values are present?","What are the worst-case complexity guarantees of unordered_map?","How would you adapt the solution if the problem asked for all unique value pairs instead of one index pair?"]},createdAt:"2026-01-01T00:00:00.000Z"},detailedSections:{"Correctness & Approach":"verdict: The code stores each number together with its original index, sorts these pairs by value, and applies the standard two-pointer method. If the current sum is too small, moving left increases the sum; if it is too large, moving right decreases the sum. Because the original indices are retained, the returned result is valid for the original array. The solution correctly handles duplicate values and never uses the same element twice because left remains strictly less than right.\n\napproach: A hash map can solve the problem in expected O(n) time with O(n) extra space by checking whether target - nums[i] has already been seen. This is asymptotically faster than the current O(n log n) sorting-based approach.","Time Complexity":"Building eleIndex takes O(n), sorting takes O(n log n), and the two-pointer scan takes O(n). Therefore, the total time complexity is O(n log n), dominated by sorting.","Space Complexity":"The eleIndex structure stores n value-index pairs, requiring O(n) auxiliary space. The sorting algorithm may also use additional implementation-dependent stack or temporary space, but the dominant extra space remains O(n).","Code Readability":"The comments make the logic easy to follow, but vector<vector> and expressions such as eleIndex[left][0] are less clear than a named pair or struct. The ans vector and n variable are acceptable, though returning the pair directly would simplify the successful case.","Edge Cases":["Duplicate values such as [3, 3] with target 6 are handled because the two occurrences have different stored indices.","Negative numbers and mixed positive and negative values are handled correctly by sorting and pointer movement.","A solution using the first and last positions is handled because the loop allows left == 0 and right == n - 1.","The minimum input size of two elements is handled correctly.","If no pair exists, the function returns {-1, -1}; under the stated problem guarantee, this fallback is not reached."],"Interview Explanation":"I first create value-index pairs so sorting will not lose the original positions. After sorting by value, I place one pointer at the smallest value and one at the largest value. If their sum is smaller than the target, I move the left pointer forward to increase the sum; if it is larger, I move the right pointer backward to decrease it. When the sum matches, I return the two stored original indices. Sorting costs O(n log n), and the pointer scan is linear, so the overall complexity is O(n log n) with O(n) extra space. If the interviewer prioritizes linear expected time, I would use a hash map instead.","Follow-up Questions":["How would you solve Two Sum in expected O(n) time using an unordered_map?","Why is it necessary to store the original indices before sorting?","How does the two-pointer method remain correct when duplicate values are present?","What are the worst-case complexity guarantees of unordered_map?","How would you adapt the solution if the problem asked for all unique value pairs instead of one index pair?"]}},cartonCandies:{inside:[{id:"ai-assistant",label:"AI Assistant",left:"28%",top:"14%",rotate:-18},{id:"guide-me",label:"Guide Me",left:"50%",top:"10%",rotate:10},{id:"get-hint",label:"Get Hint",left:"68%",top:"16%",rotate:-12},{id:"refine-ai",label:"Refine with AI",left:"36%",top:"22%",rotate:14},{id:"refine-tufy",label:"Refine with Tufy",left:"56%",top:"20%",rotate:-16},{id:"ai-generate",label:"AI generate",left:"74%",top:"12%",rotate:22},{id:"generate-notes",label:"Generate Notes",left:"42%",top:"14%",rotate:-24},{id:"generate-revision",label:"Generate Revision",left:"64%",top:"26%",rotate:8},{id:"stuck-here",label:"Stuck here",left:"48%",top:"28%",rotate:16},{id:"ask-tufy-inside",label:"Ask Tufy",left:"30%",top:"26%",rotate:-8},{id:"explain-problem",label:"Explain Problem",left:"70%",top:"24%",rotate:12},{id:"code-review",label:"Code Review",left:"60%",top:"16%",rotate:-4}],doubtSupportFeaturedIds:["ai-assistant","guide-me","ask-tufy-inside","explain-problem"],codeReviewFeaturedId:"code-review",hintsFeaturedId:"get-hint",outside:{id:"ask-tufy",label:"Ask Tufy",left:"86%",top:"72%",rotate:-6}}},p={taglineLead:"Improve accuracy and speed through ",taglineAccent:"topic-wise",taglineTail:" practice questions.",sequenceDurationMs:15500,videoThumbnail:{subjectSlug:"aptitude",approachName:"Concept",approachCount:1,estDurationSeconds:420},questions:[{id:"percent-increase",title:"Successive Percentage Change",description:"A laptop’s price is increased by 20% and then decreased by 20%. What is the net change in price?",options:["No change","4% decrease","4% increase","2% decrease"],correctOptionIndexes:[1],solutionText:`
                <h3><strong>Intuition</strong></h3>
                <p>Percentage changes compound — they do not cancel. A rise and an equal fall leave you short of the original price.</p>
                <h3><strong>Approach</strong></h3>
                <p>Take an original price of 100 for easy calculation.</p>
                <p>After a 20% increase: <code>100 \xd7 1.2 = 120</code>.</p>
                <p>After a 20% decrease on the new price: <code>120 \xd7 0.8 = 96</code>.</p>
                <p>Net change from 100 → 96 is a <strong>4% decrease</strong>.</p>
                <h3><strong>Why this works</strong></h3>
                <p>In general, a successive +x% and −x% multiplies by <code>(1 + x/100)(1 − x/100) = 1 − (x/100)\xb2</code>, so the loss is always <code>(x\xb2/100)%</code>.</p>
            `},{id:"number-series",title:"Find the Next Number",description:"Find the next number in the series: 2, 6, 12, 20, 30, ?",options:["40","42","44","46"],correctOptionIndexes:[1],solutionText:`
                <h3><strong>Intuition</strong></h3>
                <p>Look at the gaps between consecutive terms — many aptitude series grow by an arithmetic pattern on the differences.</p>
                <h3><strong>Approach</strong></h3>
                <p>Differences: 6−2=4, 12−6=6, 20−12=8, 30−20=10.</p>
                <p>Those differences increase by +2 each time.</p>
                <p>Next difference = 10 + 2 = 12.</p>
                <p>Next term = 30 + 12 = <strong>42</strong>.</p>
                <h3><strong>Why this works</strong></h3>
                <p>The nth term follows <code>n(n+1)</code>: 1\xd72, 2\xd73, 3\xd74, 4\xd75, 5\xd76, 6\xd77 → 42.</p>
            `},{id:"speed-distance",title:"Speed Distance Time",description:"A train covers 180 km in 3 hours. How long will it take to cover 300 km at the same speed?",options:["4 hours","5 hours","5.5 hours","6 hours"],correctOptionIndexes:[1],solutionText:`
                <h3><strong>Intuition</strong></h3>
                <p>At constant speed, time scales linearly with distance. First find the speed, then apply it to the new distance.</p>
                <h3><strong>Approach</strong></h3>
                <p>Speed = distance \xf7 time = <code>180 \xf7 3 = 60 km/h</code>.</p>
                <p>Required time = <code>300 \xf7 60 = 5</code> hours.</p>
                <p>So the train needs <strong>5 hours</strong>.</p>
                <h3><strong>Shortcut</strong></h3>
                <p>Time ratio equals distance ratio: <code>300/180 = 5/3</code>, so time = <code>3 \xd7 5/3 = 5</code> hours.</p>
            `}],answerIndexes:[1,0,1],paletteQuestionCount:30,tufyChat:{userText:"I picked 40 for the series 2, 6, 12, 20, 30, ?. Where did I go wrong?",assistantIntro:"You’re close — the next term isn’t +10 again. Watch how the gaps themselves grow.",whatYouDidWell:"You noticed the series is increasing and tried a constant step, which is a solid first check.",whatsMissing:"The differences aren’t fixed: they rise by +2 each time, so the next jump is +12, not +10.",hints:[{title:"Hint 1",body:"Write the gaps: 4, 6, 8, 10… What comes after 10?"},{title:"Hint 2",body:"Next gap = 12 → next term = 30 + 12. That lands on 42."}]}},m={taglineLead:"One curated problem. ",taglineAccent:"Every day.",stages:{widget:{taglineLead:"One curated problem. ",taglineAccent:"Every day.",description:"Open today’s pick from the right panel and start solving."},practice:{taglineLead:"Jump into the ",taglineAccent:"full practice page",description:"Read the problem, write code, and run against sample cases."},submit:{taglineLead:"Submit when you’re ",taglineAccent:"ready",description:"One click sends your solution through the judge."},toast:{taglineLead:"Instant ",taglineAccent:"Accepted",description:"Know immediately when your submission is correct."},calendar:{taglineLead:"Mark the day ",taglineAccent:"solved",description:"Your streak updates on the Problem of the Day calendar."}},widget:{title:"Problem Of The Day",rewardCoins:20,timer:{hours:3,minutes:57,seconds:39},ctaLabel:"Solve problem"},toast:{title:"Accepted",message:"Your submission was correct."},problem:{title:"Majority Element",difficulty:"Core",companyTags:["Google","Amazon","Microsoft"],statement:["Given an integer array nums of size n, return the majority element of the array.","The majority element of an array is an element that appears more than ⌊n / 2⌋ times in the array. You may assume that the majority element always exists in the array.","Solve it in linear time and O(1) extra space if you can."],examples:[{input:"nums = [7, 0, 0, 1, 7, 7, 2, 7]",output:"7",explanation:"7 appears 5 times in an 8-element array, which is more than ⌊8 / 2⌋."},{input:"nums = [2, 2, 1, 1, 1, 2, 2]",output:"2",explanation:"2 appears 4 times and is the majority element."}],constraints:["1 ≤ nums.length ≤ 5 × 10^4","-10^9 ≤ nums[i] ≤ 10^9","The majority element always exists in the array."],hints:[{title:"Boyer–Moore voting",description:"Track a candidate and a counter. Increment on matches, decrement otherwise, and reset the candidate when the counter hits zero."},{title:"Why it works",description:"Because the majority element appears more than n/2 times, it survives every cancel-out against other values."}],doubts:[{question:"Can I sort and pick the middle?",answer:"Yes — sorting is O(n log n) and always works when a majority is guaranteed, but interviewers usually want the linear O(1) approach."}],followUps:[{question:"What if the majority is not guaranteed?",answer:"Run a second verification pass to confirm the candidate actually exceeds n/2 occurrences."}],funFacts:["Boyer–Moore majority vote is a classic streaming algorithm from the early 1980s.","The same cancel-out idea shows up in “find the celebrity” and some pairing problems."],footer:{likes:184,dislikes:6,completedLabel:"Completed"}},code:{language:"C++",activeTab:0,tabs:["Tab-1","Tab-2"],lines:[{tokens:[{text:"int",kind:"keyword"},{text:" majorityElement(vector<int>& nums) {",kind:"plain"}]},{tokens:[{text:"    int",kind:"keyword"},{text:" candidate = 0, count = 0;",kind:"plain"}]},{tokens:[{text:"    for",kind:"keyword"},{text:" (int num : nums) {",kind:"plain"}]},{tokens:[{text:"        if",kind:"keyword"},{text:" (count == 0) candidate = num;",kind:"plain"}]},{tokens:[{text:"        count +=",kind:"plain"},{text:" (num == candidate) ? 1 : -1;",kind:"plain"}]},{tokens:[{text:"    }",kind:"plain"}]},{tokens:[{text:"    return",kind:"keyword"},{text:" candidate;",kind:"plain"}]},{tokens:[{text:"}",kind:"plain"}]}],sampleCases:[{id:"case-1",label:"Case 1",fieldLabel:"Nums",input:"[7, 0, 0, 1, 7, 7, 2, 7]"},{id:"case-2",label:"Case 2",fieldLabel:"Nums",input:"[2, 2, 1, 1, 1, 2, 2]"}],activeSampleCase:0,footerStatus:"☁ Saved"},verdict:{headerMessage:"Great work! You've successfully passed all test cases",metrics:{sampleCasesPassed:2,totalSampleCases:2,timeUsed:"4ms",memoryUsed:"8.2 MB"}},calendar:{year:2026,month:9,monthLabel:"September",focusDay:10,focusDayId:0x135282e,days:[{day:null,state:"outside"},{day:1,state:"solved"},{day:2,state:"solved"},{day:3,state:"missed"},{day:4,state:"solved"},{day:5,state:"attempted"},{day:6,state:"solved"},{day:7,state:"solved"},{day:8,state:"missed"},{day:9,state:"solved"},{day:10,state:"attempted"},{day:11,state:"future"},{day:12,state:"future"},{day:13,state:"future"},{day:14,state:"future"},{day:15,state:"future"},{day:16,state:"future"},{day:17,state:"future"},{day:18,state:"future"},{day:19,state:"future"},{day:20,state:"future"},{day:21,state:"future"},{day:22,state:"future"},{day:23,state:"future"},{day:24,state:"future"},{day:25,state:"future"},{day:26,state:"future"},{day:27,state:"future"},{day:28,state:"future"},{day:29,state:"future"},{day:30,state:"future"},{day:null,state:"outside"},{day:null,state:"outside"},{day:null,state:"outside"},{day:null,state:"outside"}]}};e.s(["LANDING_FEATURES_V2",0,[{id:"planly",label:"Planly",title:"Planly",subFeatures:[{id:"about-you",label:"About you",description:"Share your role, experience, and timeline so Planly can shape a plan that fits you."},{id:"understanding-your-goals",label:"Understanding your goals",description:"Planly reads your answers and turns them into a clear preparation direction before building your roadmap."},{id:"personalised-roadmap",label:"Personalised weekly sprints",description:"Turn one big goal into focused weekly sprints shaped around your level, deadline, and available time."},{id:"daily-tasks",label:"Solve & Practice",description:"Open Planly and know exactly what today needs—learn, revise, or practise."},{id:"learning-timer",label:"Track your time",description:"Replace guesswork with an honest view of the time you spend learning."},{id:"progress-tracker",label:"Progress tracker",description:"Watch every finished task become visible momentum across your preparation."},{id:"missed-day-task",label:"Missed a Day/Task?",description:"Fall behind and Planly helps you recover—adjust the plan or pause without losing progress."}]},{id:"complete-curriculum",label:"Curriculum",title:"Curriculum",subFeatures:[{id:"dsa-basics-advanced",label:"DSA (Basics to Advanced)",description:"Build complete DSA knowledge progressively, from fundamentals to advanced patterns."},{id:"oops",label:"OOPs Module End to End",description:"Learn object-oriented programming through concepts, examples, quizzes, and problems."},{id:"lld",label:"Low Level Design (LLD)",description:"Learn to design maintainable, object-oriented systems for technical interviews."},{id:"dbms",label:"DBMS",description:"Learn database management concepts through structured lessons and video content for interviews."},{id:"operating-systems",label:"Operating Systems",description:"Build OS fundamentals through structured lessons and video content for interviews."},{id:"computer-networks",label:"Computer Networks",description:"Master networking fundamentals through structured lessons and video content for interviews."},{id:"sql",label:"SQL",description:"Develop practical database-querying skills through structured lessons and practice."}]},{id:"rich-learning-media",label:"Resources",title:"Resources",subFeatures:[{id:"written-editorials",label:"Clean Written Editorials (Approach-wise)",description:"Understand every viable solution through clear, step-by-step written explanations."},{id:"video-editorials",label:"In-depth Video Editorials (Approach-wise)",description:"Learn different problem-solving approaches through detailed video walkthroughs."},{id:"infographic-sliders",label:"Infographic Sliders",description:"Unders