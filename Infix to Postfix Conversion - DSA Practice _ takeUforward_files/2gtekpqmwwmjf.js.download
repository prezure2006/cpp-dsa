:"aptitude-practice-sets",label:"Aptitude Practice Sets",description:"Improve accuracy and speed through topic-wise practice questions."},{id:"aptitude-mock-sets",label:"Aptitude Mock Sets",description:"Test your readiness through placement-style timed assessments."}]},{id:"practice",label:"Practice",title:"Practice",subFeatures:[{id:"practice-portal",label:"Practice Portal",description:"Pick a subject, open a problem, and submit with unlimited runs."},{id:"problem-of-the-day",label:"Problem of the Day",description:"Build consistency by solving one curated problem every day."},{id:"contests",label:"Contests",description:"Improve speed, accuracy, and decision-making in a timed environment."}]},{id:"personal-workspace",label:"Workspace",title:"Workspace",subFeatures:[{id:"workspace",label:"Workspace",description:"Save, organise, and revisit all your code from one personal workspace."},{id:"customised-lists",label:"Create Customised Lists",description:"Build problem lists for specific goals and share them with others."},{id:"downloadable-notes",label:"Downloadable Notes",description:"Generate, refine, organise, and download revision notes with AI assistance."}]},{id:"profile-additional",label:"Profile",title:"Profile",subFeatures:[{id:"profile",label:"Profile - One in All Portfolio",description:"Showcase your skills, experience, projects, progress, and achievements in one shareable profile."},{id:"certificate",label:"Certificate",description:"Receive proof of completion for eligible learning programmes and milestones."}]}],"LANDING_FEATURES_V2_APTITUDE_MOCK_SETS_PREVIEW",0,{taglineLead:"Test your readiness through ",taglineAccent:"placement-style",taglineTail:" timed assessments.",sequenceDurationMs:5600,navbar:{title:"Aptitude Mock Test",remainingMs:1782e3,durationMs:18e5},questions:[{id:"percent-increase",description:"A laptop’s price is increased by 20% and then decreased by 20%. What is the net change in price?",options:["No change","4% decrease","4% increase","2% 