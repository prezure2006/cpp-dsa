rProps",0,{orientation:"vertical",coverage:60,thickness:1,className:"bg-stroke-divider"},"buganizerStatusLabelMap",0,{open:"Open","in-progress":"In Progress",resolved:"Resolved"},"buganizerToCommentListItems",0,c,"buganizerUserReportPriorityLabelMap",0,o,"createBugReportFields",0,function(e){let t=e.descriptionField?{type:"custom",name:p.fieldName,content:e.descriptionField}:{type:"textarea",name:p.fieldName,label:p.label,value:e.description,placeholder:p.placeholder,required:!0,onChange:t=>e.onDescriptionChange(t)},o=[{type:"select",name:"category",label:"Category",value:e.category,options:n,placeholder:"Category",required:!0,onChange:t=>e.onCategoryChange(t)},{type:"text",name:"title",label:"Short Title",value:e.title,required:!0,onChange:t=>e.onTitleChange(t),labelClassName:"left-4 z-10 px-1.5 text-[0.625rem] font-normal peer-focus:text-[0.625rem] text-text-tertiary bg-bg-3 backdrop-blur-none rounded-none"},{type:"radio",name:"priority",label:"Priority",value:e.priority,options:i,onChange:t=>e.onPriorityChange(t)},t];return e.uploadField&&o.push({type:"custom",name:"upload",content:e.uploadField}),o},"createBugViewMetaFields",0,function(e){let t=[{type:"select",name:"category",label:"Category",value:e.category,options:n,disabled:!e.onCategoryChange,onChange:t=>e.onCategoryChange?.(t)},{type:"radio",name:"priority",label:"Priority",value:e.priority,options:i,onChange:t=>e.onPriorityChange(t)}];return void 0!==e.status&&t.push({type:"select",name:"status",label:"Status",value:e.status,options:l,disabled:!e.onStatusChange,onChange:t=>e.onStatusChange?.(t)}),t}])},625734,e=>{"use strict";e.s(["LANDING_FEATURES_MOCK_SHELL_FLOAT",0,{amplitudePx:7,durationS:5.5},"LANDING_FEATURES_MOCK_SHELL_SWIVEL",0,{rotateXDeg:2.25,rotateYDeg:3.5,durationXS:6.75,durationYS:8.5}])},995868,501966,e=>{"use strict";e.s(["QUIZ_PRACTICE_END_QUIZ_LABEL",0,"End Quiz","QUIZ_PRACTICE_END_QUIZ_MODAL",0,{title:"End Quiz?",description:"Once you end the quiz, you cannot change your answers. Your results will be shown next.",confirmLabel:"End Quiz",dismissLabel:"Continue"},"QUIZ_PRACTICE_OVERVIEW",0,{startLabel:"Start Practicing",restartLabel:"Restart",continueTestLabel:"Continue Test",reattemptTestLabel:"Retake Test",viewPreviousAttemptsLabel:"Previous attempts",attemptInProgressLabel:"Attempt in progress",completedLabel:"Completed",lastAttemptedOn:e=>`Last attempted on ${e}`,progressLabel:e=>`Your Progress : ${e} % Complete`,autosaveHint:"Your progress is automatically saved every 60 seconds.",previousAttemptsTitle:e=>`Previous Attempts ( ${e} )`,attemptRowLabel:e=>`Attempt ${e}`,previousAttemptsEmpty:"No previous attempts yet.",previousAttemptsLoadError:"Could not load previous attempts."},"QUIZ_PRACTICE_RETAKE_MODAL",0,{title:"Retake this test?",description:"Your current attempt and saved answers will be cleared. You will start a fresh attempt from question 1.",confirmLabel:"Retake Test",dismissLabel:"Not now"},"formatQuizPracticeAttemptDate",0,function(e){let t=new Date(e);return Number.isFinite(t.getTime())?t.toLocaleDateString("en-GB",{day:"numeric",month:"short",year:"numeric"}):e}],995868);var t=e.i(365671);function o(e){return e===t.QUIZ_QUESTION_RESULT_STATUS.correct||e===t.QUIZ_QUESTION_RESULT_STATUS.incorrect||e===t.QUIZ_QUESTION_RESULT_STATUS.unanswered}e.s(["isRevealedGrade",0,o,"resolveQuizOptionClassName",0,function({optionIndex:e,selectedOptionIndexes:r,grade:a,correctOptionIndexes:n=[]}){let i=r.includes(e);return o(a)?n.includes(e)?i?"border-transparent bg-gamification-contrast-green-951":"border-transparent bg-gamification-contrast-green-bg":i&&a===t.QUIZ_QUESTION_RESULT_STATUS.incorrect?"border-transparent bg-gamification-contrast-red-bg2":"border-stroke-strong":i?"border-brand-primary bg-shades-blue-100":"border-stroke-strong"},"resolveQuizOptionDotClassName",0,function({optionIndex:e,selectedOptionIndexes:t,grade:r,correctOptionIndexes:a=[]}){let n=t.includes(e);return o(r)?a.includes(e)?"bg-semantic-green-600":n?"bg-semantic-red-600":"bg-shades-blue-200":n?"bg-brand-primary":"bg-shades-blue-200"}],501966)},322276,e=>{"use strict";var t=e.i(719941);let o=[{data:[{tab_title:"cpp",tab_content:'#include<bits/stdc++.h>\nusing namespace std;\n\nclass Solution {\npublic:\n    // Function to remove duplicates from the vector\n    int removeDuplicates(vector<int>& nums) {\n       \n        \n        // Initialize pointer for unique elements\n        int i = 0;\n        \n        // Iterate through the vector\n        for (int j = 1; j < nums.size(); j++) {\n            /*If current element is different \n            from the previous unique element*/\n            if (nums[i] != nums[j]) {\n                /* Move to the next position in \n                the vector for the unique element*/\n                i++;\n                /* Update the current position \n                with the unique element*/\n                nums[i] = nums[j];\n            }\n        }\n        \n        \n        // Return the number of unique elements\n        return i+1;\n    }\n};\n\nint main() {\n    vector<int> nums = {1, 1, 2, 2, 2, 3, 3};\n    \n    // Create an instance of the Solution class\n    Solution solution;\n    \n    // Call removeDuplicates to remove duplicates from nums\n    int k = solution.removeDuplicates(nums);\n    \n    cout << "The vector after removing duplicate elements is " << endl;\n    for (int i = 0; i < k; i++) {\n        cout << nums[i] << " ";\n    }\n    cout << endl;\n    \n    return 0;\n}'},{tab_title:"java",tab_content:'import java.util.*;\n\nclass Solution {\n    // Function to remove duplicates from the array\n    public int removeDuplicates(int[] nums) {\n        \n        \n        // Initialize pointer for unique elements\n        int i = 0;\n        \n        // Iterate through the array\n        for (int j = 1; j < nums.length; j++) {\n            /*If current element is different \n            from the previous unique element*/\n            if (nums[i] != nums[j]) {\n                /* Move to the next position in \n                the array for the unique element*/\n                i++;\n                /* Update the current position \n                   with the unique element*/\n                nums[i] = nums[j];\n            }\n        }\n        \n        // Return the number of unique elements\n        return i + 1;\n    }\n}\n\npublic class Main {\n    public static void main(String[] args) {\n        int[] nums = {1, 1, 2, 2, 2, 3, 3};\n        \n        // Create an instance of the Solution class\n        Solution solution = new Solution();\n        \n        // Call removeDuplicates to remove duplicates from nums\n        int k = solution.removeDuplicates(nums);\n        \n        System.out.println("The array after removing duplicate elements is ");\n        for (int i = 0; i < k; i++) {\n            System.out.print(nums[i] + " ");\n        }\n        System.out.println();\n    }\n}'},{tab_title:"python",tab_content:'from typing import List\n\nclass Solution:\n    # Function to remove duplicates from the list\n    def removeDuplicates(self, nums: List[int]) -> int:\n      \n        \n        # Initialize pointer for unique elements\n        i = 0\n        \n        # Iterate through the list\n        for j in range(1, len(nums)):\n            """ If current element is different \n            from the previous unique element"""\n            if nums[i] != nums[j]:\n                \n                """ Move to the next position in \n                the list for the unique element"""\n                i += 1\n                \n                """ Update the current position \n                with the unique element"""\n                nums[i] = nums[j]\n        \n        # Return the number of unique elements\n        return i + 1\n\n# Main function to test the implementation\nif __name__ == "__main__":\n    nums = [1, 1, 2, 2, 2, 3, 3]\n    \n    # Create an instance of the Solution class\n    solution = Solution()\n    \n    # Call removeDuplicates to remove duplicates from nums\n    k = solution.removeDuplicates(nums)\n    \n    print("The list after removing duplicate elements is ")\n    for i in range(k):\n        print(nums[i], end=" ")\n    print()'},{tab_title:"javascript",tab_content:'class Solution {\n    // Function to remove duplicates from the array\n    removeDuplicates(nums) {\n      \n        // Initialize pointer for unique elements\n        let i = 0;\n        \n        // Iterate through the array\n        for (let j = 1; j < nums.length; j++) {\n            /* If current element is different \n            from the previous unique element*/\n            if (nums[i] !== nums[j]) {\n                \n                /* Move to the next position in \n                the array for the unique element*/\n                i++;\n                \n                /* Update the current position \n                with the unique element*/\n                nums[i] = nums[j];\n            }\n        }\n        \n        // Return the number of unique elements\n        return i + 1;\n    }\n}\n\n// Main function to test the implementation\nif (typeof require !== \'undefined\' && require.main === module) {\n    let nums = [1, 1, 2, 2, 2, 3, 3];\n    \n    // Create an instance of the Solution class\n    let solution = new Solution();\n    \n    // Call removeDuplicates to remove duplicates from nums\n    let k = solution.removeDuplicates(nums);\n    \n    console.log("The array after removing duplicate elements is ");\n    for (let i = 0; i < k; i++) {\n        process.stdout.write(nums[i] + " ");\n    }\n    console.log();\n}'},{tab_title:"csharp",tab_content:'using System; \nusing System.Collections.Generic; \n\npublic class Solution {\n    // Function to remove duplicates from the array\n    public int removeDuplicates(List<int> nums) {\n        // Edge case: if array is empty\n        if (nums.Count == 0) {\n            return 0;\n        }\n        \n        // Initialize pointer for unique elements\n        int i = 0;\n        \n        // Iterate through the array\n        for (int j = 1; j < nums.Count; j++) {\n            /* If current element is different \n            from the previous unique element*/\n            if (nums[i] != nums[j]) {\n                \n                /* Move to the next position in \n                the array for the unique element*/\n                i++;\n                \n                /* Update the current position \n                with the unique element*/\n                nums[i] = nums[j];\n            }\n        }\n        \n        // Return the number of unique elements\n        return i + 1;\n    }\n}\n\npublic class Program\n{\n    public static void Main(string[] args)\n    {\n        List<int> nums = new List<int> {1, 1, 2, 2, 2, 3, 3};\n        \n        // Create an instance of the Solution class\n        Solution solution = new Solution();\n        \n        // Call removeDuplicates to remove duplicates from nums\n        int k = solution.removeDuplicates(nums);\n        \n        Console.WriteLine("The array after removing duplicate elements is ");\n        for (int i = 0; i < k; i++) {\n            Console.Write(nums[i] + " ");\n        }\n        Console.WriteLine();\n    }\n}'},{tab_title:"go",tab_content:'package main\n\nimport (\n    "fmt"\n)\n\n// removeDuplicates removes duplicates from the slice in-place\nfunc removeDuplicates(nums []int) int {\n    // Edge case: if slice is empty\n    if len(nums) == 0 {\n        return 0\n    }\n\n    // Initialize pointer for unique elements\n    i := 0\n\n    // Iterate through the slice\n    for j := 1; j < len(nums); j++ {\n        /* If current element is different\n           from the previous unique element */\n        if nums[i] != nums[j] {\n            /* Move to the next position in\n               the slice for the unique element */\n            i++\n            /* Update the current position\n               with the unique element */\n            nums[i] = nums[j]\n        }\n    }\n\n    // Return the number of unique elements\n    return i + 1\n}\n\nfunc main() {\n    nums := []int{1, 1, 2, 2, 2, 3, 3}\n\n    // Call removeDuplicates to remove duplicates from nums\n    k := removeDuplicates(nums)\n\n    fmt.Println("The slice after removing duplicate elements is")\n    for i := 0; i < k; i++ {\n        fmt.Print(nums[i], " ")\n    }\n    fmt.Println()\n}'}],"div-id":"tuf-code-editor-1",code_output:""}],r=[{"div-id":"tuf-code-file-tree-1",language_label:"C++",data:[{type:"folder",name:"controller",children:[{type:"file",name:"AdminController.cpp",path:"controller/AdminController.cpp",content:`#include "AdminController.h"
#include "AdminService.h"

using namespace std;

AdminController::AdminController(shared_ptr<AdminService> adminService)
    : adminService(adminService) {}

void AdminController::createAdmin(const Admin& admin) {
    adminService->createAdmin(admin);
}

Admin AdminController::getAdmin(int id) {
    return adminService->getAdmin(id);
}`,language:"cpp"}]},{type:"folder",name:"domain",children:[]},{type:"folder",name:"main",children:[]},{type:"folder",name:"repository",children:[]},{type:"folder",name:"service",children:[{type:"file",name:"nextNameSome.cpp",path:"service/nextNameSome.cpp",content:`#include "nextNameSome.h"

void nextNameSome() {
    // placeholder implementation
}`,language:"cpp"}]}],symbols:[{name:"AdminService",kind:"class",file_path:"controller/AdminController.cpp",line:7,target_file_path:"service/nextNameSome.cpp",target_line:1}]}],a=[{name:"Brute",editorial:[{section:'<div id="editorial-video"></div><h3><strong>Intuition</strong></h3>\n<p>The naive way is to think of a data structure that does not store duplicate elements, that is HashSet. Keep track of unique elements in hashset, and at last copy all the elements from the HashSet to the original array.</p>\n<h3><strong>Approach&nbsp;</strong></h3>\n<li>Declare a HashSet and traverse the array by putting every element of the array in the HashSet.</li>\n<li>Store size of the set in a variable <code>K</code>. Now put all elements of the set in the array from the starting of the array and finally return <code>K</code>.</li>\n<h3>Solution</h3>\n<div id="tuf-code-editor-1"></div>\n<h3><strong>Complexity Analysis&nbsp;</strong></h3>\n<strong>Time Complexity: </strong> O(N * log N) + O(N), for using hashset and traversing once.<br>\n<strong>Space Complexity: </strong> O(N).',examples:[],code_editor:o,tuf_plus_ad:[],image_slider:[],practice_link:[],video:[{asset_id:"5SK8jC3Tu6j"}],code_file_tree:[]}]},{name:"Optimal",editorial:[{section:'<div id="editorial-video"></div><h3><strong>Intuition</strong></h3>\n<p>Imagine you have a shelf where your books are sorted and repeated titles appear. You want each title only once while keeping order.</p>\n<p>Use two pointers: one marks the last unique element and one scans ahead. When a new value appears, place it at the next unique slot.</p>\n<h3><strong>Approach&nbsp;</strong></h3>\n<li>Initialize <code>i = 0</code> and scan using <code>j = 1</code>.</li>\n<li>Whenever <code>nums[j] != nums[i]</code>, increment <code>i</code> and copy <code>nums[j]</code> to <code>nums[i]</code>.</li>\n<li>After traversal, answer is <code>i + 1</code>.</li>\n<h3><strong>Dry Run</strong></h3>\n<div id="tuf-image-slider-1"></div>\n<h3>Solution</h3>\n<div id="tuf-code-editor-1"></div>\n<h3><strong>Complexity Analysis&nbsp;</strong></h3>\n<strong>Time Complexity: </strong> O(N).<br>\n<strong>Space Complexity: </strong> O(1).',examples:[],code_editor:o,tuf_plus_ad:[],image_slider:[{data:[{alt_text:"Image 1",image_url:"https://static.takeuforward.org/premium/Arrays/Logic Building/Remove duplicates from sorted array/2.svg-Q9Y5jWsI"},{alt_text:"Image 2",image_url:"https://static.takeuforward.org/premium/Arrays/Logic Building/Remove duplicates from sorted array/3.svg-eTxILvAf"},{alt_text:"Image 3",image_url:"https://static.takeuforward.org/premium/Arrays/Logic Building/Remove duplicates from sorted array/4.svg-7JgnURfM"},{alt_text:"Image 4",image_url:"https://static.takeuforward.org/premium/Arrays/Logic Building/Remove duplicates from sorted array/5.svg-vB4I0D5a"}],"div-id":"tuf-image-slider-1"}],practice_link:[],video:[{asset_id:"9hFhZRJrSYd"}],code_file_tree:[]}]}];a.map(e=>({label:e.name,value:(0,t.toSolutionValue)(e.name)})),Object.fromEntries(a.map(e=>[(0,t.toSolutionValue)(e.name),e])),e.s(["SOLUTION_PANEL_CODE_EDITOR",0,o,"SOLUTION_PANEL_CODE_FILE_TREE",0,r,"SOLUTION_PANEL_GENERATE_REVISION_COPY",0,{buttonLabel:"Generate Revision",viewButtonLabel:"View Revision",dialogTitle:"Thinking ....",dialogDescription:"Please wait while TUFY is working on revision image.",mascotAlt:"TUFY thinking",mascotSrc:"/tufy/thinking.svg",mediaAlt:"Revision notes image",mediaDialogAriaLabel:"Revision media",downloadLabel:"Download",importLabel:"Import to Notes",missingSlugMessage:"Open a problem to generate revision notes."},"SOLUTION_PANEL_REVISION_NOTE",0,{imageMarkdown:(e,t="Revision notes")=>`![${t}](${e})`,tags:[{label:"Revision",value:"revision"}]}])},692296,e=>{"use strict";var t=e.i(785112),o=e.i(726352);e.s(["useAnalyticsPromptTarget",0,function(e,r){let[a,n]=(0,t.useState)({isOpen:!1,target:""});return a.isOpen!==e&&n({isOpen:e,target:e?(0,o.getAnalyticsLastClickedButton)()?.uuid??r:a.target}),a.target||r}])},473229,e=>{e.v({bot