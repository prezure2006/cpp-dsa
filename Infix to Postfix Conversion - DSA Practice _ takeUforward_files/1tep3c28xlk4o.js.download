||l.startsWith(`${u}/`)?`#${o.LANDING_FAQ_SECTION_ID}`:t;return(0,a.jsx)(i.IntentPrefetchLink,{href:_,className:r,children:e})}])},320520,e=>{"use strict";e.s(["LANDING_FAQ_CATEGORY_ENTER",0,{duration:.3,ease:"easeOut"},"LANDING_FAQ_CATEGORY_EXIT",0,{duration:.15},"LANDING_FAQ_CATEGORY_SLIDE_Y",0,10])},514528,409618,e=>{"use strict";var a=e.i(896627),n=e.i(447483),o=e.i(680955),s=e.i(535447),i=e.i(657270),t=e.i(785236);let r=`<a href="${o.CONTACT_EMAIL_MAILTO}"><strong>${o.CONTACT_EMAIL}</strong></a>`,l=`<a href="${n.WHATSAPP_SUPPORT_URL}" target="_blank" rel="noopener noreferrer"><strong>+91 63714 18920</strong></a>`,d=`<a href="${(0,t.buildNavHref)("privacyPolicy")}">Privacy Policy</a>`,u=`<a href="${(0,t.buildNavHref)("cancellationPolicy")}">Cancellation and Refund Policy</a>`,_=`<a href="${(0,t.buildNavHref)("account.upgrade")}">Profile → Account</a>`,c=`<a href="${(0,t.buildPricingHref)()}">pricing page</a>`,g=`<a href="${a.TUF_SOCIAL.discord.href}" target="_blank" rel="noopener noreferrer">Discord learning community</a>`,m=`<a href="${(0,t.buildNavHref)("prepHub")}">Prep Hub</a>`,p=`<a href="${(0,t.buildNavHref)("planly")}">Planly</a>`,b=`<a href="${(0,t.buildNavHref)("notes")}">NoteSpace</a>`,f=`<a href="${(0,t.buildNavHref)("lists")}">revision lists</a>`,h=`<a href="${(0,t.buildNavHref)("codespace")}">Workspace</a>`,y=`<a href="${(0,t.buildNavHref)("practice.dsa")}">Practice section</a>`,L=`<a href="${(0,t.buildNavHref)("ide")}">online compiler</a>`,Y=`<a href="${(0,t.buildNavHref)("contactUs")}">Contact Us</a>`;function G(e,a){return`<a href="${(0,t.linkGenerator)({kind:"prepHub",subjectSlug:e,page:"sheet"})}">${a}</a>`}let k=G("strivers-a2z-dsa-sheet","Striver's A2Z DSA Sheet"),w=G("strivers-sde-pattern-sheet","SDE Pattern Sheet"),v=G("strivers-75-sheet","Striver's 75"),C=G("blind-75","Blind 75"),M=[{id:"what-is-takeuforward",categoryId:"getting-started",question:"What is takeUforward?",answer:"takeUforward is a platform for technical interview and placement preparation. It brings together structured learning, coding practice, personalised study plans, and revision tools so you can build your fundamentals and prepare for interviews in one place."},{id:"complete-beginner",categoryId:"getting-started",question:"Can I use takeUforward if I am a complete beginner?",answer:"Yes. Start with programming basics, then follow a structured path into data structures and algorithms. You do not need a computer science background to begin. If you already have coding experience, choose the topics and practice sets that match your preparation needs."},{id:"what-has-changed",categoryId:"getting-started",question:"What has changed in the new takeUforward?",answer:`The upgraded experience brings your preparation together: find structured learning paths in ${m}, plan your study with ${p}, get help from TUFY, and practise DSA and SQL on the platform. ${b}, ${f}, and ${h} help you organise your notes, problems, and code.`},{id:"start-for-free",categoryId:"getting-started",question:"Can I start learning for free?",answer:`Yes. You can begin with the free learning resources available on takeUforward and explore the curriculum before choosing a paid plan. Premium content and feature access depend on your plan. The ${c} explains what each option includes.`},{id:"subjects",categoryId:"learning-curriculum",question:"What subjects can I prepare on takeUforward?",answer:`You can prepare Data Structures and Algorithms, Object-Oriented Programming, Low-Level Design, DBMS, Operating Systems, Computer Networks, SQL, and aptitude. ${m} brings the available subject paths and revision sheets together, helping you choose what to study for placements or your next technical interview.`},{id:"which-dsa-sheet",categoryId:"learning-curriculum",question:"Which DSA sheet should I start with?",answer:`Start with ${k} if you want to learn from the basics in a structured order. Once you know the fundamentals, use the ${w} to revisit problem-solving patterns, or ${v} and ${C} for a smaller interview revision set.`},{id:"languages",categoryId:"learning-curriculum",question:"Which programming languages can I learn with?",answer:"DSA explanations use pseudocode, with reference solutions in C++, Java, Python, JavaScript, C#, and Go. OOPs and Low-Level Design use Java walkthroughs, with code solutions also available in C++ and Python. Check the language options on the problem you are practising."},{id:"video-explanations-landing",categoryId:"learning-curriculum",question:"Does every problem have a video explanation?",answer:"Videos are available for selected problems and lessons. You can also learn through written editorials that explain the intuition, approach, and solution, with visual explanations where available. Attempt the problem first, then use the explanation to understand where your approach can improve."},{id:"planly-help",categoryId:"planning-progress",question:"How does Planly help me prepare?",answer:`${p} builds a study roadmap around your goal, current level, preparation timeline, and available study time. It organises your preparation into weekly sprints with daily learning, practice, and revision tasks, so you know what to work on next.`},{id:"miss-a-study-day",categoryId:"planning-progress",question:"What if I miss a study day or fall behind?",answer:`Use ${p} to review your pending tasks and adjust your preparation schedule. You can reorganise unfinished work around the time you have available and continue from your progress. Aim for a manageable routine that leaves room for both new topics and revision.`},{id:"track-progress",categoryId:"planning-progress",question:"How can I track my progress?",answer:"Your learning paths show what you have completed and what remains. Planly's progress tracker helps you review your study progress, while your submissions show the problems you have attempted. Use these together to identify topics that need another attempt or more revision."},{id:"own-pace",categoryId:"planning-progress",question:"Can I learn at my own pace, and how long will preparation take?",answer:"Yes. You can fit learning around college or work and revisit topics when needed. Preparation time depends on your starting level, target role, and available study hours. Set a realistic schedule that includes learning, independent practice, and revision rather than aiming only to finish a sheet."},{id:"practise-on-platform",categoryId:"practice-support",question:"Can I practise coding and SQL directly on takeUforward?",answer:`Yes. The ${y} lets you write, run, and submit solutions to DSA and SQL problems. Follow a sheet while learning a topic, or choose individual problems for focused practice. You can also use the ${L} to experiment with code.`},{id:"tufy-help",categoryId:"practice-support",question:"What can TUFY help me with?",answer:"TUFY is your AI learning assistant. It can help explain a problem, guide you towards an approach, clarify an editorial, and debug your code. Ask about the specific step you are stuck on, then use the guidance to continue solving. Access and usage limits depend on the feature and your plan."},{id:"code-review-when",categoryId:"practice-support",question:"What is Code Review, and when should I use it?",answer:"Code Review gives feedback on an accepted solution, including its approach, time and space complexity, readability, and possible improvements. Use it after solving a problem to understand your implementation more deeply and practise explaining the trade-offs behind your code."},{id:"quizzes-mocks-contests",categoryId:"practice-support",question:"Are there quizzes, mock tests, or contests?",answer:"Yes. Available assessments include quizzes, aptitude practice sets and mock tests, and coding contests. Use quizzes to check your understanding, mocks to practise timing and accuracy, and contests to solve under time pressure. Access depends on the assessment and your plan."},{id:"notes-and-revision",categoryId:"revision-help",question:"How can I organise my notes and revision problems?",answer:`Use ${b} to keep explanations, key ideas, and mistakes together. Create ${f} for problems you want to attempt again, and use ${h} to save and organise your code. This gives you a place to return to when revising a topic or preparing for an interview.`},{id:"company-prep",categoryId:"revision-help",question:"Can I prepare for a specific company?",answer:"Yes. Company-specific problems and company tags help you focus your practice, while interview experiences help you understand the rounds and questions candidates have encountered. Use these alongside your fundamentals and the requirements of your target role; interview questions can change."},{id:"earn-certificate",categoryId:"revision-help",question:"Can I earn a certificate?",answer:"Certificates are available for eligible learning paths once you meet their completion requirements. Check the certificate details for the path you are following. A certificate records your learning achievement; your interview performance and practical skills remain important when applying for a role."},{id:"get-help",categoryId:"revision-help",question:"Where can I get help if I have a question or face an issue?",answer:`For learning doubts, use the available hints, editorials, TUFY, and community discussions. For account, access, or technical issues, contact ${r} or use ${Y}. Include the relevant page link and a description of the issue so the team can help.`}],I=[{id:"future-features",categoryId:"subscription",question:"Will I receive access to new features and content released in the future?",answer:"The content and features included in your plan at the time of purchase will remain accessible throughout your subscription period, including lifetime access where applicable.<br><br>We regularly introduce improvements and new content. Access to future additions will depend on their scope and cost. If major premium features or courses are introduced separately, existing subscribers will have the option to upgrade at discounted rates."},{id:"access-duration",categoryId:"subscription",question:"How long will I have access to TUF+?",answer:`Your access depends on the plan and subscription duration selected at purchase. Available durations vary by plan; please review the options on the ${c}.`},{id:"upgrade-plan-later",categoryId:"subscription",question:"Can I upgrade my plan later?",answer:`Yes. Go to ${_} and select the upgrade option to upgrade your current plan.`},{id:"continue-after-expiry",categoryId:"subscription",question:"Can I continue learning after my subscription expires?",answer:"Yes. Once your subscription expires, you can purchase an available plan of your choice to continue learning."},{id:"upgrade-price-calc",categoryId:"subscription",question:"Can I upgrade my existing plan? How is the upgrade price calculated?",answer:"Yes. You can upgrade your existing plan at any time.<br><br>If you upgrade while your current plan is still active, the remaining validity of your existing plan is converted into credits. These credits are applied as a discount against the price of your new plan.<br><br>Once you upgrade, your existing plan will be discontinued and the new plan will become active."},{id:"upgrade-replaces-current-plan",categoryId:"subscription",question:"If I upgrade from a Lifetime plan, does my Lifetime access continue?",answer:`If your current plan is a Lifetime plan and you upgrade to a higher plan, your Lifetime plan will end immediately.<br><br>The new plan will start from the date of upgrade and will follow the validity and features of the plan you upgraded to.<br><br>Your Lifetime validity will not be carried forward to the new plan. Review available upgrades in ${_} before you proceed.`},{id:"plan-expiry-date",categoryId:"subscription",question:"Where can I check my plan expiry date?",answer:"You can check your current plan's expiry date in your account dashboard."},{id:"renew-extend",categoryId:"subscription",question:"Can I renew or extend my existing plan?",answer:"If you purchase a new plan as an upgrade, your existing plan will be discontinued and the new plan will become active. The applicable upgrade discount is calculated based on the remaining validity of your current plan."},{id:"videos-downloadable",categoryId:"subscription",question:"Can I download videos for use after my subscription expires?",answer:"Videos cannot be downloaded as standalone files. Access to subscription videos is available while your subscription remains active."},{id:"download-notes",categoryId:"subscription",question:"Can I download course notes?",answer:"Downloadable notes are available on the platform. Use the download option provided for the relevant material."},{id:"beginner-prerequisites",categoryId:"course-content",question:"Is TUF+ suitable for beginners? Are there any prerequisites?",answer:"Yes. TUF+ is designed for beginners and learners with prior programming experience. The foundational modules teach concepts from the beginning, although familiarity with programming may help you progress faster.<br><br>Start with the first video in the Basics section and follow the recommended sequence."},{id:"who-teaches",categoryId:"course-content",question:"Who teaches the courses on TUF+?",answer:"The course content is taught by Striver, also known as Raj Vikramaditya."},{id:"dsa-topics",categoryId:"course-content",question:"What does the DSA course include?",answer:"The DSA course covers foundational through advanced concepts, supported by problem-solving exercises, editorial explanations, contests, and problems across different difficulty levels."},{id:"programming-languages",categoryId:"course-content",question:"Which programming languages are supported?",answer:"<table><thead><tr><th>Module</th><th>Language used for explanations</th><th>Languages available for code solutions</th></tr></thead><tbody><tr><td>DSA</td><td>Pseudocode</td><td>C++, Java, Python, JavaScript, C#, Go</td></tr><tr><td>OOPs</td><td>Java</td><td>Java, C++, Python</td></tr><tr><td>LLD</td><td>Java</td><td>Java, C++, Python</td></tr></tbody></table>"},{id:"oops-lld-not-java",categoryId:"course-content",question:"Can I follow the OOPs and LLD modules if I do not code in Java?",answer:"Yes. The explanations focus on concepts and approaches that can be applied across programming languages. Code solutions are available in Java, C++, and Python.<br><br>A one-hour introductory Java video is also available to help you become familiar with the language."},{id:"video-explanations",categoryId:"course-content",question:"Does every problem include a video explanation?",answer:"Selected explanatory problems include videos in the Editorial section. For other problems, you can refer to the written intuition, approach, and solution."},{id:"aptitude-prep",categoryId:"course-content",question:"Does TUF+ include aptitude preparation?",answer:"Yes. TUF+ includes aptitude practice sets, mock tests, and assessments for placement preparation. Each problem in the aptitude practice sets includes a written explanation and a video explanation."},{id:"sql-dbms",categoryId:"course-content",question:"Does the SQL module cover DBMS?",answer:"Yes. The SQL module covers DBMS fundamentals. It also includes company-specific premium SQL problems and a query playground for practising SQL queries."},{id:"concept-quick-revision",categoryId:"course-content",question:"When should I use Concept Revision or Quick Revision?",answer:"Use Concept Revision to revisit DSA concepts and strengthen your understanding across topics.<br><br>Use Quick Revision for focused preparation when an interview is approximately one or two weeks away. It provides a day-wise problem schedule."},{id:"content-updates",categoryId:"course-content",question:"Is the course content updated regularly?",answer:"Yes. We update the content based on learner feedback and identified improvements. Access to newly introduced premium content is subject to your plan's inclusion policy."},{id:"completion-time",categoryId:"course-content",question:"How long does it take to complete the course?",answer:"Completion time depends on your starting level, chosen learning track, and daily practice.<br><br>As an indicative DSA schedule:<ul><li>Beginners: Approximately six months at two hours per day.</li><li>Learners with a stronger foundation: Approximately 45 days at four hours per day.</li></ul>"},{id:"code-review",categoryId:"coding-features",question:"What is Code Review, and how does it work?",answer:"Code Review is a premium feature that analyses a correct solution and provides feedback on:<ul><li>Individual lines of code.</li><li>Code quality, readability, and structure.</li><li>How the solution compares with an expected approach.</li><li>Time and space complexity.</li></ul><br>The feedback helps you improve your implementation and understand opportunities for optimization."},{id:"code-review-not-visible",categoryId:"coding-features",question:"Why is Code Review not visible for my solution?",answer:"Code Review is available only for correct solutions. Ensure that your solution is correct and has been successfully submitted before checking for the review."},{id:"submit-analysis",categoryId:"coding-features",question:"Why am I unable to submit my solution for further analysis?",answer:"Your solution must run successfully and be correct before it can be submitted for further analysis. Run your code and resolve any errors before proceeding.<br><br>If the issue persists, contact support with your account type, the problem name, and the error encountered."},{id:"multiple-approaches",categoryId:"coding-features",question:"Can I write multiple approaches to the same problem?",answer:"Yes. Use the editor's multiple-tab feature to write different approaches in separate tabs.<br><br>All tabs for the same problem must use one programming language. Using different languages across these tabs is not supported."},{id:"stuck-on-problem",categoryId:"coding-features",question:"What support is available if I get stuck on a problem?",answer:"You can use the available hints, Frequently Occurring Doubts (FODs), and Interview Follow-Up Questions (IFQs) to develop your understanding. The AI Doubt Portal also provides assistance, subject to your plan's access."},{id:"pip-video",categoryId:"coding-features",question:"How can I watch a video while coding in another tab?",answer:"Use Picture-in-Picture (PiP) mode, where supported by your browser and video player. This opens the video in a floating window that you can resize and reposition while coding."},{id:"reset-progress",categoryId:"progress",question:"How can I reset my progress for a topic?",answer:"<ol><li>Locate the relevant topic card.</li><li>Open the three-dot menu.</li><li>Select Reset Progress.</li></ol><br>This resets the internal progress of that topic card. Your overall Global Progress remains unchanged."},{id:"theory-videos-complete",categoryId:"progress",question:"Why are theory videos not automatically marked as completed?",answer:"Theory videos must be marked as completed manually. Coding problems are automatically marked as completed after a correct solution is successfully submitted."},{id:"custom-lists",categoryId:"progress",question:"Where can I find my custom lists?",answer:"Return to the Plus dashboard and select the note-shaped icon beside the relevant topic name."},{id:"streak-restore",categoryId:"progress",question:"Can my streak be restored if I miss a day?",answer:"Streak restoration is not available for missed activity, except where the interruption is caused by a platform-wide website issue."},{id:"activity-ist",categoryId:"progress",question:"Why is my activity recorded on a different date when I am outside India?",answer:"The platform follows Indian Standard Time (IST). Your activity is recorded according to IST, which may fall on a different calendar date from your local time."},{id:"leaderboard",categoryId:"progress",question:"Why am I not appearing on the leaderboard?",answer:"You must maintain a streak of at least two days to appear on the leaderboard.<br><br>If you meet this requirement and are still not visible, contact support for assistance."},{id:"adjust-schedule",categoryId:"progress",question:"Can I adjust my learning schedule if I fall behind?",answer:"Yes. The roadmap adjusts according to your learning pace and backlog to help you reorganize your preparation."},{id:"share-account",categoryId:"account",question:"Can two learners purchase or share one account?",answer:"No. Each TUF+ account is intended for one learner. Sharing an account interferes with individual progress tracking and may result in account restrictions or suspension."},{id:"multiple-devices",categoryId:"account",question:"Can I use TUF+ on multiple devices?",answer:"You can access your account from different devices, but only one active session is permitted at a time. Signing in on another device may end the previous session."},{id:"login-options",categoryId:"account",question:"Which login methods are available, and how long does the login session last?",answer:"You can sign in using an OTP or your Google account.<ul><li>OTP login: The OTP is valid for 24 hours. After this period, you may need to verify again.</li><li>Google login: You can sign in directly using your Google account.</li><li>Login expiry: Your login session may expire after 30 days, after which you may be asked to log in again.</li><li>New-device login: If you log in from a new device, your existing session on another device may be logged out.</li></ul><br>These rules help keep your account secure across different devices and login methods."},{id:"change-email",categoryId:"account",question:"Who should I contact about changing my registered email address?",answer:`Changing your registered email address is generally not allowed. However, in exceptional cases, such as when a college or official office email address has been used, we may consider the request on a case-by-case basis.<br><br>For assistance, please contact ${r}.`},{id:"personal-info",categoryId:"account",question:"How is my personal information protected?",answer:`We take reasonable measures to protect personal information against unauthorized access, misuse, and disclosure. Details about the collection, use, and sharing of information are available in our ${d}.`},{id:"delete-account",categoryId:"account",question:"Can I delete my account permanently?",answer:"Yes. You can permanently delete your TUF account.<br><br>Deleting your account will remove your access to the account and your learning progress. This action cannot be undone.<br><br>To delete your account, go to Profile → Danger Zone → Permanently Delete Account."},{id:"pause-subscription",categoryId:"account",question:"Can I pause my subscription, and what happens after it expires?",answer:"No. Subscription validity cannot be paused. Adjusting your learning roadmap does not pause your subscription.<br><br>However, your saved code, learning progress, notes, and other account data will remain available even after your subscription expires. You can resume learning from where you left off once you reactivate your subscription."},{id:"topic-access",categoryId:"technical-support",question:"Why can I not access LLD, OOPs, SQL, or another topic?",answer:"Check whether the topic is included in your current subscription. If it is not included, you will need a plan that provides access.<br><br>If your plan includes the topic but it remains inaccessible, contact support."},{id:"cant-access-course",categoryId:"technical-support",question:"I cannot access my purchased course. What should I do?",answer:`Contact ${r} or WhatsApp ${l}. Include your registered email address, purchased plan, and a description of the issue so the team can investigate.`},{id:"videos-not-loading",categoryId:"technical-support",question:"What should I do if videos are not loading?",answer:`Contact support on WhatsApp ${l}. Include the affected video or topic, your device and browser details, and any error message displayed.`},{id:"system-requirements",categoryId:"technical-support",question:"What are the system requirements?",answer:"A laptop, a stable internet connection, and an up-to-date browser are sufficient to use the website."},{id:"office-laptops",categoryId:"technical-support",question:"Can I use TUF+ on an office laptop?",answer:"Yes, provided your organization permits access. If the website or video player is blocked, contact your IT team or use a personal device."},{id:"global-access",categoryId:"technical-support",question:"Can I access TUF+ from outside India?",answer:"Yes. TUF+ is accessible to learners outside India."},{id:"dedicated-mentor",categoryId:"mentorship",question:"Does TUF+ provide a dedicated mentor or one-to-one mentoring?",answer:"No. TUF+ does not currently provide dedicated mentors or one-to-one mentoring sessions."},{id:"group-study",categoryId:"mentorship",question:"Are group study sessions available?",answer:`We do not currently organize group study sessions. You can connect with other learners through the ${g} and form your own study groups.`},{id:"certificate-modules",categoryId:"certification",question:"Which modules offer certificates?",answer:"Certificates are available for eligible completion of the following modules:<ul><li>DSA</li><li>OOPs</li><li>LLD</li><li>Operating Systems (OS)</li><li>Computer Networks (CN)</li><li>SQL</li><li>DBMS</li></ul>"},{id:"generate-certificate",categoryId:"certification",question:"When and how can I generate a certificate?",answer:"You can generate a certificate after completing at least 75% of the relevant topic:<ol><li>Locate the topic card.</li><li>Open the three-dot menu.</li><li>Select Get Certificate.</li></ol>"},{id:"exams-required",categoryId:"certification",question:"Do I need to pass a separate examination to receive a certificate?",answer:"No separate examination is required. Eligibility is based on meeting the topic's completion requirement."},{id:"certificate-meaning",categoryId:"certification",question:"What does a TUF+ certificate demonstrate?",answer:"A TUF+ certificate records that you have met the platform's completion requirement for the relevant module."},{id:"career-counseling",categoryId:"career",question:"Does TUF+ offer personal career counselling?",answer:"No. TUF+ does not currently offer one-to-one career counselling. The Planly feature helps guide and organize your preparation."},{id:"assessments",categoryId:"career",question:"Are assessments included?",answer:"Yes. TUF+ includes contests, quizzes, and practice exercises. Access depends on your selected plan and module."},{id:"job-placement",categoryId:"internships",question:"Does TUF+ provide placement support or guarantee an internship or job?",answer:"No. TUF+ does not currently offer job placement support or guarantee internships or employment.<br><br>The courses are designed to help you develop the knowledge and skills needed to pursue opportunities independently."},{id:"resume-workshops",categoryId:"internships",question:"Are resume-building workshops available?",answer:"Dedicated resume-building workshops are not currently offered."},{id:"payment-modes",categoryId:"payment",question:"Which payment methods are available?",answer:"Payment options include UPI, credit and debit cards, cardless EMI, and other EMI options, subject to availability and eligibility at checkout."},{id:"pay-outside-india",categoryId:"payment",question:"Can I purchase a plan from outside India?",answer:"Yes. PayPal is available for learners outside India."},{id:"pay-country",categoryId:"payment",question:"What should I do if I cannot complete a payment from my country?",answer:`Contact support on WhatsApp ${l} for assistance with available payment alternatives, including bank-transfer details where applicable.`},{id:"payment-not-active",categoryId:"payment",question:"My payment was deducted, but my subscription is not active. What should I do?",answer:`Contact ${r} or WhatsApp ${l} with:<ul><li>Your registered email address.</li><li>The transaction reference.</li><li>The payment date.</li><li>The payment confirmation.</li></ul><br>The team will investigate the payment and access status.`},{id:"company-cash-card",categoryId:"payment",question:"Can I use a company-issued cash card to purchase or upgrade a plan?",answer:"No. Company-issued or organizational cash cards are not supported for purchasing or upgrading plans."},{id:"upgrade-payment-replaces-plan",categoryId:"payment",question:"If I pay to upgrade from a Lifetime plan, what happens to my Lifetime access?",answer:"If your current plan is a Lifetime plan and you upgrade to a higher plan, your Lifetime plan will end immediately.<br><br>The new plan will start from the date of upgrade and will follow the validity and features of the plan you upgraded to.<br><br>Your Lifetime validity will not be carried forward to the new plan."},{id:"request-refund",categoryId:"payment",question:"Can I cancel my subscription or request a refund?",answer:`Payments are non-refundable, and subscriptions cannot be cancelled once activated under the published policy. Please review the course details and free preview before purchasing. See the ${u}.`}];e.s(["LANDING_PAGE_FAQ",0,{description:"Find your starting point and learn how to make the most of takeUforward.",categories:[{id:"getting-started",label:"Getting started"},{id:"learning-curriculum",label:"Learning and curriculum"},{id:"planning-progress",label:"Planning and progress"},{id:"practice-support",label:"Practice and learning support"},{id:"revision-help",label:"Revision, interviews, and help"}],items:M},"PLUS_FAQ",0,{description:"Access to courses and premium features depends on your subscription plan.",categories:[{id:"subscription",label:"Subscription and Future Updates"},{id:"course-content",label:"Course Content and Curriculum"},{id:"coding-features",label:"Coding Features and Doubt Support"},{id:"progress",label:"Progress, Streaks, and Custom Lists"},{id:"account",label:"Account Management"},{id:"technical-support",label:"Course Access and Technical Support"},{id:"mentorship",label:"Mentorship and Community Support"},{id:"certification",label:"Certificates"},{id:"career",label:"Career Guidance and Assessments"},{id:"internships",label:"Internships and Job Assistance"},{id:"payment",label:"Payments and Refunds"}],items:I}],409618);let T={headlineLead:"One Stop",headlineLeadRest:"Learning Platform",headlineAccent:"for Tech Interviews",description:"Learn DSA, System Design, and Core CS Subjects with personalised roadmaps, expert videos, and practice built for results.",startCta:"Start Learning for free",dashboardCta:"Go to dashboard",plusCta:"Explore plus",previewTitle:"TUFY to help you",previewSubtitle:"Your AI tutor to guide you in your preparation journey.",previewUserMessage:s.TUFY_PROMPTS.feelingStuck,previewAssistantLines:["Hey, your direction actually looks quite solid right now.","Let’s figure out the right edge cases before thinking about code."],previewHints:["Hint 1","Hint 2"],reachHeadline:"Engineers learning on TUF",reachDescription:"From YouTube to LinkedIn, our global community keeps growing every day. TUF is the go-to place for engineers preparing for tech interviews.",reachCtaGuest:"Join Our Community",reachCtaMember:"Explore Community",featuresBadge:"Features",featuresHeadlineLead:"Powerful Tools.",featuresHeadlineAccent:"One Platform.",featuresDescription:"Stop switching between multiple resources. Prepare confidently with an integrated platform built for aspiring software engineers.",testimonialsBadge:"Testimonials",testimonialsHeadlineLead:"Trusted by",testimonialsHeadlineAccent:"Thousands of Engineers",testimonialsDescription:"Hear from students and professionals...",testimonialsCta:"Hall of Fame",testimonialsReadMore:"Read more",testimonialsError:"Testimonials are temporarily unavailable. Please try again later.",testimonialsModalClose:"Close testimonial",featureVideosHeadlineLead:"Everything You Need",featureVideosHeadlineAccent:"to Crack Interviews",featureVideosDescription:"Master DSA, System Design, Core CS, Aptitude, and more — with Planly and TUFY guiding every step of your prep.",counsellingModalTitle:"START PERSONALIZATION",counsellingQuestion:"What best describes you?",counsellingQuestionHint:"To recommend the right guidance call, tell us a little about yourself.",counsellingBatchLabel:"Graduation batch",counsellingBack:"Back",counsellingContinue:"Continue",counsellingConfirm:"Confirm",counsellingCancelSession:"Cancel Session",counsellingCloseAria:"Close",counsellingHelpGoalQuestion:"What do you need help with?",counsellingHelpGoalHint:"Choose the role that matches your goal",counsellingDetailsQuestion:"Tell us a little about yourself",counsellingDetailsHint:"Briefly tell us which TUF+ feature or resource you need help using.",counsellingNameLabel:"Full name",counsellingNamePlaceholder:"Enter your name",counsellingEmailLabel:"Email (registered)",counsellingEmailPlaceholder:"Enter your registered email",counsellingPhoneLabel:"Phone number",counsellingPhonePlaceholder:"Enter phone number",counsellingSupportQueryLabel:"What would you like help with",counsellingSupportQueryFieldLabel:"Email",counsellingSupportQueryPlaceholder:"I am confused about...",counsellingScheduleQuestion:"Choose a convenient time",counsellingScheduleHint:"Select an available slot over the next 5–7 days.",counsellingAvailableSlots:"Available slots",counsellingReviewQuestion:"Review your booking",counsellingReviewHint:"Please confirm your details before we schedule your Google Meet session.",counsellingMeetingQuestion:"Your booking",counsellingMeetingHint:"You're all set. Join your Google meet at the scheduled time.",counsellingPreviousQuestion:"All your previous meetings",counsellingReviewName:"Name",counsellingReviewEmail:"Email",counsellingReviewDate:"Date",counsellingReviewTime:"Time",counsellingReviewPhone:"Phone",counsellingStepLabel:"Step",callbackHeadline:"Request a Callback from us",callbackDescription:"We're just a message away!",callbackPhone:o.CONTACT_PHONE_DISPLAY,callbackEmail:o.CONTACT_EMAIL,callbackEmailAria:`Email ${o.CONTACT_EMAIL}`,callbackWhatsAppAria:"Chat on WhatsApp",callbackNamePlaceholder:"Enter your name",callbackPhonePlaceholder:"Enter phone number",callbackEmailPlaceholder:"Enter your email",callbackMessagePlaceholder:"I am confused about...",callbackSendAria:"Send message",faqHeadline:"Frequently asked questions",faqDescription:"Find your starting point and learn how to make the most of takeUforward.",faqCategoryLabel:"Select category",footerExploreCta:"Explore Plus",footerStartCta:"Start for free",footerWatermark:"takeUforward"},S="landing-faq-heading",A=[{id:"learn",title:"Learn",links:[{label:"Prep Hub",href:(0,t.buildNavHref)("prepHub")},{label:"Striver's A2Z DSA Sheet",href:(0,t.linkGenerator)({kind:"prepHub",subjectSlug:"strivers-a2z-dsa-sheet",page:"sheet"})},{label:"System Design",href:(0,t.buildNavHref)("prepHub",{open:"system-design"})},{label:"Core CS Subjects",href:(0,t.buildNavHref)("prepHub",{open:"core-cs"})},{label:"Blogs",href:(0,t.buildNavHref)("blogs")}]},{id:"practice",title:"Practice",links:[{label:"DSA Problems",href:(0,t.buildNavHref)("practice.dsa")},{label:"SQL Problems",href:(0,t.buildNavHref)("practice.sql")},{label:"Aptitude & Reasoning",href:(0,t.buildNavHref)("practice.quantitative")},{label:"Problem of the Day",href:(0,t.buildNavHref)("potd")}]},{id:"features",title:"Features",links:[{label:"Planly",href:(0,t.buildNavHref)("planly")},{label:"NoteSpace",href:(0,t.buildNavHref)("notes")},{label:"Revision Lists",href:(0,t.buildNavHref)("lists")},{label:"Online Compiler",href:(0,t.buildNavHref)("ide")}]},{id:"company",title:"Company & Support",links:[{label:"Community",href:(0,t.buildNavHref)("community")},{label:"Contact Us",href:(0,t.buildNavHref)("contactUs")},{label:"Help & FAQs",href:`${(0,t.buildNavHref)("pricing")}#${S}`,resolveFaq:!0},{label:"Pricing",href:(0,t.buildPricingHref)()}]}],P=[{label:"Privacy Policy",href:(0,t.buildNavHref)("privacyPolicy")},{label:"Terms & Conditions",href:(0,t.buildNavHref)("termsAndConditions")},{label:"Cancellation & Refund Policy",href:(0,t.buildNavHref)("cancellationPolicy")}],D={start:(0,t.buildNavHref)("prepHub"),plus:(0,t.buildPricingHref)(),community:(0,t.buildNavHref)("community"),hof:(0,t.buildNavHref)("hof"),callbackPhone:o.CONTACT_PHONE_TEL,callbackEmail:o.CONTACT_EMAIL_MAILTO,callbackWhatsApp:n.WHATSAPP_SUPPORT_URL},N=[{kind:"youtube",targetValue:a.TUF_SOCIAL.youtube.followerCount,label:a.TUF_SOCIAL.youtube.followerLabel,handle:a.TUF_SOCIAL.youtube.handle,href:a.TUF_SOCIAL.youtube.href},{kind:"linkedin",targetValue:a.TUF_SOCIAL.linkedinCompany.followerCount,label:a.TUF_SOCIAL.linkedinCompany.followerLabel,handle:a.TUF_SOCIAL.linkedinCompany.handle,href:a.TUF_SOCIAL.linkedinCompany.href}];e.s(["LANDING_COPY",0,T,"LANDING_FAQ_SECTION_ID",0,S,"LANDING_FEATURE_CARDS",0,[{id:"planly",mockId:"planly",title:"Planly",description:"Know exactly what you have to do each day. Planned.",detailTitle:"DAILY PLANNING",detailBody:"Know exactly what you have to do each day with structured tasks, progress tracking, and a clear prep roadmap."},{id:"tufy",mockId:"tufy",title:"TUFY to help you",description:"Your AI tutor to guide you in your preparation journey.",detailTitle:"AI-POWERED GUIDANCE",detailBody:"Your AI tutor to guide you in your preparation journey with hints, feedback, and direction when you get stuck."},{id:"companies",mockId:"companies",title:"Company Specific Problems",description:"Problem sets to prepare for your dream company",detailTitle:"COMPANY-SPECIFIC INTERVIEW PREP",detailBody:"Target your dream job with practice sets curated for companies like Google, Amazon, Microsoft, and more."},{id:"dsa-sheet",mockId:"dsa-sheet",title:"Most Trusted DSA Sheet",description:"Your complete interview preparation journey.",detailTitle:"STRUCTURED DSA SHEET",detailBody:"Follow a trusted, topic-wise sheet from basics to advanced problems so your prep stays complete and interview-ready."}],"LANDING_FOOTER_COLUMNS",0,A,"LANDING_FOOTER_LEGAL_LINKS",0,P,"LANDING_HREFS",0,D,"LANDING_PREVIEW_TODO_SIZE_WEB",0,{width:"33.6rem",height:"30.675rem"},"LANDING_PREVIEW_TUFY_SIZE_WEB",0,{width:"31.0545rem",height:"28.4124rem",tiltDeg:0},"LANDING_REACH_CARDS",0,N,"LANDING_TESTIMONIAL_CARD_STRIDE_PX",0,316,"LANDING_TESTIMONIAL_CAROUSEL_SPEED",0,.2,"LANDING_TESTIMONIAL_INITIAL_CARD_COUNT",0,10,"LANDING_TESTIMONIAL_VIDEO_PREVIEW_SEC",0,10,"LANDING_TESTIMONIAL_WEB_CARD_STRIDE_PX",0,386,"getLandingFooterCopyright",0,function(e=(0,i.getIstNow)().getFullYear()){return`\xa9 ${e} Moveforward Private Limited. All rights reserved.`}],514528)}]);